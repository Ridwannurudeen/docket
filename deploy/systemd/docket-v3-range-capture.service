[Unit]
Description=Docket v3 Range pool-truth capture — the registered 2026-08-26T12:10:00Z observation
# Deliberately not Wants=docket.service: this reads two public URLs and has nothing to do
# with the API being up. Coupling them would let a Docket restart move a registered moment.
Wants=network-online.target
After=network-online.target
# No ordering against docket-v3-capture.service: its final bounded attempt ends before this
# unit starts, while ordering would let a failed Yield restart delay the Range observation.
StartLimitIntervalSec=15min
StartLimitBurst=3

[Service]
Type=oneshot
User=docket
Group=docket
WorkingDirectory=/var/lib/docket
# The family id makes the running installed package supply the registered specification.
ExecStart=/opt/docket/.venv/bin/python -m docket.advantage.v3.capture \
  v3-05-range-doctor /var/lib/docket/v3-capture/range

# This pre-arms before a one-minute window and cannot be repeated, so it does not yield CPU
# or IO to the rest of the shared host.
Nice=-5
TimeoutStartSec=15min
Restart=on-failure
RestartSec=30s
RestartPreventExitStatus=2 3
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/docket
