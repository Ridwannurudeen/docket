# Copy this directive into nginx's existing http {} block.
limit_req_zone $binary_remote_addr zone=docket_hire_per_ip:10m rate=30r/m;

# Copy this location into Docket's existing server {} block. Keep the general Docket
# location alongside it for every non-hire path. This outer limit bounds free, paid and
# recovery request bursts; the application separately bounds free hires and recovery.
location ^~ /hire/ {
    limit_req zone=docket_hire_per_ip burst=10 nodelay;
    limit_req_status 429;

    proxy_pass http://127.0.0.1:8090;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
